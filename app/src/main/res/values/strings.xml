    <string name="hint_branches">Cross</string>
    <string name="hint_branches_description">The four directions laid out as the d-pad, each saying what it leads to. Clearest, and the tallest.</string>
    <string name="hint_inline">One line</string>
    <string name="hint_inline_description">The same four branches on a single row.</string>
    <string name="hint_off">Off</string>
    <string name="hint_off_description">Nothing. Turn this off once your thumb knows the codes — until then there is no other reminder, because nothing is printed on the remote.</string>

    <string name="settings_codes_change_warning">Changing this rebuilds every code. Harmless while you are reading the guide — it only costs you something once you have stopped.</string>

    <string name="settings_tree_scope">Code table</string>
    <string name="scope_per_language">One per language</string>
    <string name="scope_per_language_description">Codes fitted to each language\'s own letter frequencies. About a per cent fewer presses, measured on held-out titles.</string>
    <string name="scope_shared">One for all languages</string>
    <string name="scope_shared_description">One table covering every language, and no language to switch. About a per cent more presses. Worth it only once you have stopped reading the guide, where a switch sitting in the wrong position starts to bite.</string>

    <string name="binding_delete">Delete button</string>
    <string name="binding_delete_prompt">Press the button you want for deleting</string>
    <string name="binding_delete_fallback">Delete is already a code, so this is optional. It is still the one most worth assigning: deleting is the correction you make most, and a button costs one press instead of two or three.</string>
    <string name="binding_language">Language button</string>
    <string name="binding_language_prompt">Press the button you want for switching language</string>
    <string name="binding_language_fallback">Optional. The language switch is a code too, and holding this button opens the list instead of cycling.</string>
    <string name="binding_layer">Digits button</string>
    <string name="binding_layer_prompt">Press the button you want for switching to digits and back</string>
    <string name="binding_layer_fallback">Optional. The digit layer is a code too, and a field that asks for numbers opens in it by itself.</string>

